@startuml
top to bottom direction
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #A80036
  HeaderBackgroundColor #FEFECE
  FontName SansSerif
  FontSize 12
}
skinparam stereotypeCBackgroundColor #ADD1B2
skinparam stereotypeABackgroundColor #A9DCDF
skinparam stereotypeIBackgroundColor #B4A7E5
skinparam stereotypeEBbackgroundColor #EB937F

package modelo {
  interface Cotizable {
    + calcularValorComercial() : double
  }

  abstract class Vehiculo {
    - identificador : String
    - marca : String
    - modelo : String
    - anio : int
    - color : String
    - condicion : CondicionVehiculo
    - kilometraje : int
    - valorComercial : double
    # Vehiculo(identificador : String, marca : String, modelo : String, anio : int, color : String, condicion : CondicionVehiculo, kilometraje : int, valorComercial : double)
    + getIdentificador() : String
    + getMarca() : String
    + setMarca(marca : String) : void
    + getModelo() : String
    + setModelo(modelo : String) : void
    + getAnio() : int
    + setAnio(anio : int) : void
    + getColor() : String
    + setColor(color : String) : void
    + getCondicion() : CondicionVehiculo
    + setCondicion(condicion : CondicionVehiculo) : void
    + getKilometraje() : int
    + setKilometraje(kilometraje : int) : void
    + getValorComercial() : double
    + setValorComercial(valorComercial : double) : void
    + equals(obj : Object) : boolean
    + hashCode() : int
    + {abstract} getTipoVehiculo() : TipoVehiculo
    + calcularValorComercial() : double
    # descripcionComun() : String
    + toString() : String
    # {static} validarNoNulo(valor : Object, nombreCampo : String) : void
    - {static} validarTextoNoVacio(valor : String, nombreCampo : String) : void
    - {static} validarAnio(anio : int) : void
    - {static} validarCondicion(condicion : CondicionVehiculo) : void
    - {static} validarKilometraje(condicion : CondicionVehiculo, kilometraje : int) : void
    - {static} validarValorComercial(valorComercial : double) : void
  }

  class Auto extends Vehiculo {
    - carroceria : Carroceria
    + Auto(identificador : String, marca : String, modelo : String, anio : int, color : String, condicion : CondicionVehiculo, kilometraje : int, valorComercial : double, carroceria : Carroceria)
    + getCarroceria() : Carroceria
    + setCarroceria(carroceria : Carroceria) : void
    + toString() : String
    + getTipoVehiculo() : TipoVehiculo
  }

  class Camioneta extends Vehiculo {
    - carroceria : Carroceria
    + Camioneta(identificador : String, marca : String, modelo : String, anio : int, color : String, condicion : CondicionVehiculo, kilometraje : int, valorComercial : double, carroceria : Carroceria)
    + getCarroceria() : Carroceria
    + setCarroceria(carroceria : Carroceria) : void
    + toString() : String
    + getTipoVehiculo() : TipoVehiculo
  }

  class Motocicleta extends Vehiculo {
    - estilo : EstiloMotocicleta
    + Motocicleta(identificador : String, marca : String, modelo : String, anio : int, color : String, condicion : CondicionVehiculo, kilometraje : int, valorComercial : double, estilo : EstiloMotocicleta)
    + getEstilo() : EstiloMotocicleta
    + setEstilo(estilo : EstiloMotocicleta) : void
    + toString() : String
    + getTipoVehiculo() : TipoVehiculo
  }

  enum Carroceria {
    SEDAN
    HATCHBACK
    SUV
    COUPE
    PICKUP
    FURGON
  }

  enum CondicionVehiculo {
    NUEVO
    USADO
  }

  enum EstiloMotocicleta {
    DEPORTIVA
    CRUISER
    SCOOTER
    ENDURO
    NAKED
    TOURING
  }

  enum TipoVehiculo {
    AUTO
    CAMIONETA
    MOTOCICLETA
  }
}

package excepciones {
  class DatoVehiculoInvalidoException extends Exception {
    - {static} serialVersionUID : long
    + DatoVehiculoInvalidoException(mensaje : String)
    + DatoVehiculoInvalidoException(mensaje : String, causa : Throwable)
  }

  class VehiculoDuplicadoException extends Exception {
    - {static} serialVersionUID : long
    + VehiculoDuplicadoException(mensaje : String)
    + VehiculoDuplicadoException(mensaje : String, causa : Throwable)
  }

  class VehiculoNoEncontradoException extends Exception {
    - {static} serialVersionUID : long
    + VehiculoNoEncontradoException(mensaje : String)
    + VehiculoNoEncontradoException(mensaje : String, causa : Throwable)
  }
}

package persistencia {
  interface RepositorioGenerico<T, ID> {
    + guardar(entidad : T) : void
    + buscarPorId(id : ID) : T
    + listarTodos() : List<T>
    + eliminar(id : ID) : void
  }

  class RepositorioVehiculos {
    - {static} RUTA_POR_DEFECTO : Path
    - archivo : Path
    + RepositorioVehiculos()
    + RepositorioVehiculos(archivo : Path)
    + getArchivo() : Path
    + guardar(entidad : Vehiculo) : void
    + buscarPorId(id : String) : Vehiculo
    + listarTodos() : List<Vehiculo>
    + eliminar(id : String) : void
    - leerTodos() : List<Vehiculo>
    - escribirTodos(vehiculos : List<Vehiculo>) : void
  }

  class VehiculoCodec {
    - {static} SEPARADOR : char
    - {static} ESCAPE : char
    - {static} CANTIDAD_CAMPOS : int
    - VehiculoCodec()
    ~ {static} codificar(vehiculo : Vehiculo) : String
    ~ {static} decodificar(registro : String) : Vehiculo
    - {static} dividirCampos(registro : String) : String[]
    - {static} escapar(valor : String) : String
    - {static} desescapar(campo : String) : String
    - {static} parsearEntero(campo : String, nombre : String) : int
    - {static} parsearDecimal(campo : String, nombre : String) : double
    - {static} parsearEnum(tipo : Class<E>, campo : String, nombre : String) : E
  }
}

package servicio {
  class ConcesionariaService {
    - repositorio : RepositorioGenerico<Vehiculo, String>
    - stock : List<Vehiculo>
    - indice : Map<String, Vehiculo>
    + ConcesionariaService()
    + ConcesionariaService(repositorio : RepositorioGenerico<Vehiculo, String>)
    + cargar() : void
    + recargar() : void
    + alta(vehiculo : Vehiculo) : void
    + baja(id : String) : void
    + buscarPorId(id : String) : Vehiculo
    + listarTodos() : List<Vehiculo>
    + modificarValorComercial(id : String, nuevoValor : double) : void
    + modificarKilometraje(id : String, nuevoKm : int) : void
    + filtrarPorMarca(marca : String) : List<Vehiculo>
    + filtrarPorCondicion(condicion : CondicionVehiculo) : List<Vehiculo>
    + filtrarPorTipo(tipo : TipoVehiculo) : List<Vehiculo>
    + filtrarPorRangoPrecio(minimo : double, maximo : double) : List<Vehiculo>
  }
}

package diseno {
  class EntradaConsola {
    - lector : Scanner
    + EntradaConsola()
    + leerTexto(mensaje : String) : String
    + leerEntero(mensaje : String) : int
    + leerDecimal(mensaje : String) : double
    + leerEnum(mensaje : String, tipo : Class<E>) : E
    + leerOpcion(mensaje : String, minimo : int, maximo : int) : int
    - listarConstantes(tipo : Class<E>) : String
    + close() : void
  }

  class FormulariosVehiculo {
    - entrada : EntradaConsola
    + FormulariosVehiculo(entrada : EntradaConsola)
    + solicitarAuto() : Vehiculo
    + solicitarCamioneta() : Vehiculo
    + solicitarMotocicleta() : Vehiculo
    - solicitarDatosComunes() : DatosComunes
  }

  class Main {
    - servicio : ConcesionariaService
    - entrada : EntradaConsola
    - formularios : FormulariosVehiculo
    - Main(servicio : ConcesionariaService, entrada : EntradaConsola)
    + {static} main(args : String[]) : void
    - ejecutar() : void
    - mostrarMenu() : void
    - procesarOpcion(opcion : int) : boolean
    - darDeAlta() : void
    - solicitarVehiculo(tipo : int) : Vehiculo
    - modificar() : void
    - consultar() : void
    - bajar() : void
    - mostrarListado(vehiculos : List<Vehiculo>) : void
  }
}

' Relaciones de herencia
Vehiculo <|-- Auto
Vehiculo <|-- Camioneta
Vehiculo <|-- Motocicleta
Cotizable <|.. Vehiculo
Exception <|-- DatoVehiculoInvalidoException
Exception <|-- VehiculoDuplicadoException
Exception <|-- VehiculoNoEncontradoException
RepositorioGenerico <|.. RepositorioVehiculos

' Composicion / agregacion
ConcesionariaService *-- "1" RepositorioGenerico : repositorio
ConcesionariaService *-- "0..*" Vehiculo : stock
ConcesionariaService *-- "0..*" Vehiculo : indice
FormulariosVehiculo *-- "1" EntradaConsola : entrada
Main *-- "1" ConcesionariaService : servicio
Main *-- "1" EntradaConsola : entrada
Main *-- "1" FormulariosVehiculo : formularios

' Dependencias
VehiculoCodec ..> Auto
VehiculoCodec ..> Camioneta
VehiculoCodec ..> Motocicleta
RepositorioVehiculos ..> VehiculoCodec
ConcesionariaService ..> CondicionVehiculo
ConcesionariaService ..> TipoVehiculo
FormulariosVehiculo ..> Carroceria
FormulariosVehiculo ..> EstiloMotocicleta
FormulariosVehiculo ..> CondicionVehiculo
Main ..> Vehiculo
Main ..> CondicionVehiculo
Main ..> TipoVehiculo

@enduml
